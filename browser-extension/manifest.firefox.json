{
    "manifest_version": 3,
    "name": "Vigil Autofill",
    "version": "1.0",
    "description": "Autofill passwords and credentials from your Vigil",
    "permissions": [
        "activeTab",
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "scripts": ["dist/background.js"]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "dist/content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup/popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "autofill@vigil.app",
            "strict_min_version": "109.0"
        }
    }
}