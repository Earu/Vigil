{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "rootDir": "./",
        "moduleResolution": "bundler",
        "types": [
            "chrome",
            "firefox-webext-browser"
        ]
    },
    "include": [
        "*.ts",
        "popup/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}