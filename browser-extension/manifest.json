{
    "manifest_version": 2,
    "name": "Password Manager Autofill",
    "version": "1.0",
    "description": "Autofill passwords and credentials from your password manager",
    "permissions": [
        "activeTab",
        "storage",
        "tabs",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "dist/background.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "dist/content.js"
            ]
        }
    ],
    "browser_action": {
        "default_popup": "popup/popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "password-manager@yourdomain.com",
            "strict_min_version": "57.0"
        }
    }
}