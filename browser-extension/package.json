{
    "name": "vigil-autofill",
    "version": "1.0.0",
    "description": "Vigil Autofill Browser Extension",
    "type": "module",
    "scripts": {
        "build": "node build.js",
        "watch": "node build.js --watch",
        "firefox:dev": "concurrently \"npm run watch\" \"web-ext run\"",
        "chrome:dev": "npm run watch",
        "firefox:build": "npm run build && web-ext build",
        "chrome:build": "npm run build"
    },
    "devDependencies": {
        "@types/chrome": "^0.0.254",
        "@types/firefox-webext-browser": "^111.0.1",
        "@types/uuid": "^10.0.0",
        "concurrently": "^8.2.2",
        "esbuild": "^0.20.1",
        "typescript": "^5.0.0",
        "web-ext": "^7.8.0",
        "@types/webextension-polyfill": "^0.10.7",
        "@types/serviceworker": "^0.0.79"
    }
}
