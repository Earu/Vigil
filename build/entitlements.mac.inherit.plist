<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the Electron helper processes (GPU, Renderer, Plugin).
     These deliberately do NOT carry application-identifier or
     keychain-access-groups. Those are provisioning-profile-authorized
     entitlements, the helpers have their own bundle identifiers
     (earu.vigil.app.helper.*) and no embedded profile, so claiming them makes
     the kernel SIGKILL every helper at launch: the GPU process dies six times
     and the app aborts with "GPU process isn't usable. Goodbye."
     Only the main app talks to the keychain, so only the main app needs them. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
