{
	"name": "vigil",
	"private": true,
	"version": "1.4.0",
	"description": "A password manager with modern UI, security checks, and more.",
	"author": "Ryan",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build && electron-builder --config electron-builder.config.js",
		"preview": "vite preview",
		"electron:dev": "node electron/build.mjs && node electron/copy-native-modules.mjs && concurrently \"vite\" \"cross-env NODE_ENV=development electron dist-electron/main.js --ozone-platform-hint=auto\"",
		"electron:build": "tsc -b && vite build && node electron/build.mjs && node electron/copy-native-modules.mjs && electron-builder --config electron-builder.config.js",
		"test": "vitest run"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"@types/zxcvbn": "^4.4.5",
		"electron-log": "^5.4.4",
		"jsqr": "^1.4.0",
		"kdbxweb": "^2.1.1",
		"keytar": "^7.9.0",
		"node-hid": "^3.4.0",
		"passport-desktop": "^0.1.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tweetnacl": "^1.0.3",
		"zxcvbn": "^4.4.2"
	},
	"devDependencies": {
		"@types/js-yaml": "^4.0.9",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^18.3.17",
		"@types/react-dom": "^18.3.5",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^8.2.2",
		"cross-env": "^7.0.3",
		"detect-libc": "^2.0.3",
		"electron": "^44.0.0",
		"electron-builder": "^26.15.3",
		"electron-updater": "^6.8.9",
		"esbuild": "^0.20.2",
		"js-yaml": "^4.3.2",
		"node-addon-api": "^8.3.0",
		"qrcode": "^1.5.4",
		"typescript": "~5.6.2",
		"vite": "^6.0.3",
		"vite-plugin-electron": "^0.28.8",
		"vite-plugin-top-level-await": "^1.4.4",
		"vite-plugin-wasm": "^3.4.1",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"kdbxweb": {
			"@xmldom/xmldom": "^0.8.15"
		},
		"tar-fs": "^2.1.5"
	},
	"main": "dist-electron/main.js",
	"allowScripts": {
		"electron@44.0.0": true,
		"electron-winstaller@5.4.0": true,
		"esbuild@0.20.2": true,
		"esbuild@0.24.2": true,
		"keytar@7.9.0": true,
		"@swc/core@1.10.4": true
	}
}
